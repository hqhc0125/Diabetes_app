<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 顶部标题栏区域（包含标题和“历史”按钮） -->    <!--android:background="#00BFFF"-->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:background="#00BFFF"
            android:padding="10dp">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="账 号 设 置"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:layout_centerInParent="true"
                android:fontFamily="sans-serif-medium" />

        </RelativeLayout>

        <!-- 头像 -->
        <ImageView
            android:id="@+id/iv_profile_picture_settings"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_default_avatar"
            android:layout_marginBottom="16dp"
            android:scaleType="centerCrop"
            android:background="@drawable/avatar_border"
            android:clickable="true" />

        <!-- 用户名 -->
        <EditText
            android:id="@+id/et_username_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="请输入用户名"
            android:layout_marginBottom="16dp" />

        <!-- 性别选择 -->
        <Spinner
            android:id="@+id/sp_gender_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/gender_array"
            android:layout_marginBottom="16dp" />

        <!-- 年龄 -->
        <EditText
            android:id="@+id/et_age_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="请输入年龄"
            android:inputType="number"
            android:layout_marginBottom="16dp" />

        <!-- 身高 -->
        <EditText
            android:id="@+id/et_height_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="请输入身高（cm）"
            android:inputType="number"
            android:layout_marginBottom="16dp" />

        <!-- 体重 -->
        <EditText
            android:id="@+id/et_weight_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="请输入体重（kg）"
            android:inputType="numberDecimal"
            android:layout_marginBottom="16dp" />

        <!-- 原密码 -->
        <EditText
            android:id="@+id/et_old_password_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="请输入原密码"
            android:inputType="textPassword"
            android:layout_marginBottom="16dp" />

        <!-- 新密码 -->
        <EditText
            android:id="@+id/et_new_password_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="请输入新密码"
            android:inputType="textPassword"
            android:layout_marginBottom="16dp" />

        <!-- 确认新密码 -->
        <EditText
            android:id="@+id/et_confirm_password_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="请确认新密码"
            android:inputType="textPassword"
            android:layout_marginBottom="24dp" />

        <!-- 保存按钮 -->
        <Button
            android:id="@+id/btn_save_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="保存设置" />
    </LinearLayout>
</ScrollView>