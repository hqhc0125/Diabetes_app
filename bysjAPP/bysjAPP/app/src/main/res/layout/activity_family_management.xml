<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 顶部标题栏区域（包含标题和“历史”按钮） -->    <!--android:background="#00BFFF"-->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:background="#00BFFF"
        android:padding="10dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="连 接 家 人"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:layout_centerInParent="true"
            android:fontFamily="sans-serif-medium" />


    </RelativeLayout>

    <EditText
        android:id="@+id/et_family_account"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="请输入家人账号"
        android:padding="20dp"
        android:layout_marginTop="150dp"/>

    <Button
        android:id="@+id/btn_connect_family"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="连接家人账号"
        android:textSize="20dp"
        android:backgroundTint="#f47920"
        android:layout_marginTop="30dp" />

    <Button
        android:id="@+id/btn_view_family_history"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="查看历史记录"
        android:textSize="20dp"
        android:layout_marginTop="30dp"
        android:enabled="false"
        android:backgroundTint="#808080" />
</LinearLayout>