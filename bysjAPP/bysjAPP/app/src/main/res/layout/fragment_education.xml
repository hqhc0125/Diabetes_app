<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#e8f5fb"
    android:padding="8dp">

    <!-- *ScrollView 的唯一子布局* -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <!-- 顶部标题栏区域（包含标题和“历史”按钮） -->    <!--android:background="#00BFFF"-->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#00BFFF"
            android:padding="10dp">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="资 讯 科 普"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:layout_centerInParent="true"
                android:fontFamily="sans-serif-medium" />

        </RelativeLayout>

        <!-- 搜索栏 -->
        <SearchView
            android:id="@+id/search_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:queryHint="搜索控糖内容"
            android:iconifiedByDefault="false"
            android:layout_marginBottom="16dp"
            android:background="@drawable/rounded_card_background" />

        <!-- 第一部分：控糖知识库 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/knowledge_section_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 标题栏 -->
                <LinearLayout
                    android:id="@+id/knowledge_section_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#F5F5F5"
                    android:padding="8dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="24dp"
                        android:background="#2196F3"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/section_title_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="控糖知识库"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        tools:ignore="DuplicateIds" />

                    <TextView
                        android:id="@+id/knowledge_more_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="更多"
                        android:textSize="16sp"
                        android:textColor="#2196F3"
                        android:padding="8dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- 内容区域 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/knowledge_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginVertical="8dp" />

        <!-- 第二部分：健康指南文章 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/guide_section_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 标题栏 -->
                <LinearLayout
                    android:id="@+id/guide_section_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#F5F5F5"
                    android:padding="8dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="24dp"
                        android:background="#2196F3"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/section_title_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="健康指南文章"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        tools:ignore="DuplicateIds" />

                    <TextView
                        android:id="@+id/guide_more_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="更多"
                        android:textSize="16sp"
                        android:textColor="#2196F3"
                        android:padding="8dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- 内容区域 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/guide_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginVertical="8dp" />

        <!-- 第三部分：最新控糖动态 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/news_section_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:backgroundTint="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 标题栏 -->
                <LinearLayout
                    android:id="@+id/news_section_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#F5F5F5"
                    android:padding="8dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="24dp"
                        android:background="#2196F3"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/section_title_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="最新控糖动态"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        tools:ignore="DuplicateIds" />

                    <TextView
                        android:id="@+id/news_more_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="更多"
                        android:textSize="16sp"
                        android:textColor="#2196F3"
                        android:padding="8dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- 内容区域 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/news_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
