<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#e8f5fb"
    android:fillViewport="true">

    <!-- 新增一个 LinearLayout 作为 ScrollView 的唯一直接子视图 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 标题栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#00BFFF"
            android:padding="6dp">

            <Button
                android:id="@+id/btn_measurement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="测 量"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:background="@android:color/transparent" />

            <Button
                android:id="@+id/btn_history_record"
                android:layout_weight="1"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:background="@android:color/transparent"
                android:text="历 史" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 连接按钮区域 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_connect_device"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="连接硬件设备"
                    android:textSize="20dp"
                    app:backgroundTint="#FFA500"
                    app:cornerRadius="20dp"
                    android:textColor="#FFFFFF"
                    android:padding="12dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_connected_device"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="状态：未连接"
                android:textColor="@color/white"
                android:background="#76becc"
                android:textSize="18sp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"/>

            <!-- 在原有布局基础上添加当前值显示区域 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#DAE3F3"
                android:padding="16dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="葡萄糖浓度(μmol/mM)"
                    android:textSize="20sp"
                    android:textColor="#002060"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/tv_display_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0.00"
                    android:textSize="36sp"
                    android:gravity="center"
                    android:layout_marginTop="8dp"
                    android:textColor="#002060"/>
            </LinearLayout>

            <!-- 图表区域 -->
            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/line_chart"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="16dp" />

            <!-- 数据统计区域 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_start_detection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="点击开始检测"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                app:backgroundTint="#009ad6"
                app:cornerRadius="24dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="#00BFFF"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:id="@+id/tv_statistic_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="本次数据统计"
                        android:textSize="24sp"
                        android:textColor="@color/white"
                        android:padding="10dp"
                        android:layout_gravity="center"/>
                </LinearLayout>

                <!-- 检测时长 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/label_test_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="本次检测时长："
                        android:textSize="16sp" />
                    <TextView
                        android:id="@+id/tv_test_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0s"
                        android:textSize="16sp"
                        android:layout_marginStart="16dp"/>
                </LinearLayout>

                <!-- 最大值 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">
                    <TextView
                        android:id="@+id/label_max_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="最大值："
                        android:textSize="16sp" />
                    <TextView
                        android:id="@+id/tv_max_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="16sp"
                        android:layout_marginStart="16dp"/>
                </LinearLayout>

                <!-- 最小值 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">
                    <TextView
                        android:id="@+id/label_min_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="最小值："
                        android:textSize="16sp" />
                    <TextView
                        android:id="@+id/tv_min_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="16sp"
                        android:layout_marginStart="16dp"/>
                </LinearLayout>

                <!-- 平均值 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">
                    <TextView
                        android:id="@+id/label_avg_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="平均值："
                        android:textSize="16sp" />
                    <TextView
                        android:id="@+id/tv_avg_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="16sp"
                        android:layout_marginStart="16dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 检测分析区域 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:background="@drawable/rounded_analysis_bg"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="本次检测分析"
                    android:textSize="20sp"
                    android:textColor="#002060"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/tv_detection_analysis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="检测完成后将显示分析结果..."
                    android:textSize="16sp"
                    android:textColor="#002060"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_fetch_analysis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:text="获取分析报告"
                    android:enabled="false"
                    app:backgroundTint="#00BFFF"
                    app:cornerRadius="20dp"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>